rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function pinCreateCommon() {
      return request.resource.data.keys().hasAll(['name', 'latitude', 'longitude', 'rating', 'ratingCount', 'ratingSum'])
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'latitude',
          'longitude',
          'nearbyLandmarks',
          'rating',
          'ratingCount',
          'ratingSum',
          'price',
          'isFree',
          'details',
          'imageUrls',
          'bidet',
          'shower',
          'cleanWater',
          'cleanToilet',
          'mirror',
          'ownerUid',
          'verified',
          'createdAt',
          'updatedAt',
          'localOnly'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is number
        && request.resource.data.ratingCount >= 1
        && request.resource.data.ratingCount <= 1000000
        && request.resource.data.ratingSum is number
        && request.resource.data.ratingSum >= request.resource.data.ratingCount
        && request.resource.data.ratingSum <= request.resource.data.ratingCount * 5
        && request.resource.data.isFree is bool
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 10000
        && (!request.resource.data.keys().hasAny(['nearbyLandmarks'])
          || (request.resource.data.nearbyLandmarks is string && request.resource.data.nearbyLandmarks.size() <= 220))
        && (!request.resource.data.keys().hasAny(['details'])
          || (request.resource.data.details is string && request.resource.data.details.size() <= 3000))
        && (!request.resource.data.keys().hasAny(['id'])
          || request.resource.data.id is string)
        && (!request.resource.data.keys().hasAny(['imageUrls'])
          || request.resource.data.imageUrls is list)
        && (!request.resource.data.keys().hasAny(['bidet'])
          || request.resource.data.bidet is bool)
        && (!request.resource.data.keys().hasAny(['shower'])
          || request.resource.data.shower is bool)
        && (!request.resource.data.keys().hasAny(['cleanWater'])
          || request.resource.data.cleanWater is bool)
        && (!request.resource.data.keys().hasAny(['cleanToilet'])
          || request.resource.data.cleanToilet is bool)
        && (!request.resource.data.keys().hasAny(['mirror'])
          || request.resource.data.mirror is bool)
        && (!request.resource.data.keys().hasAny(['localOnly'])
          || request.resource.data.localOnly == false)
        && (!request.resource.data.keys().hasAny(['verified'])
          || request.resource.data.verified == false);
    }

    function pinCreateAuthed() {
      return request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'latitude', 'longitude', 'ownerUid'])
        && pinCreateCommon();
    }

    function pinCreateAnonymous() {
      return request.auth == null
        && pinCreateCommon()
        && (!request.resource.data.keys().hasAny(['ownerUid'])
          || request.resource.data.ownerUid == null);
    }

    function ownerUpdateKeysOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'verified',
          'verifiedAt',
          'verifiedByUid',
          'createdAt',
          'ownerUid',
          'id',
          'ratingCount',
          'ratingSum',
        ]);
    }

    function noOwnerPin() {
      return !resource.data.keys().hasAny(['ownerUid']) || resource.data.ownerUid == null;
    }

    function openPinFieldUpdateOk() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['verified', 'verifiedAt', 'verifiedByUid', 'createdAt', 'id', 'ratingCount', 'ratingSum']);
    }

    function claimOwnerOk() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid'])
        || (noOwnerPin() && request.resource.data.ownerUid == request.auth.uid);
    }

    function publicRatingVoteOk() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let prevCount = resource.data.get('ratingCount', 1);
      let prevRating = resource.data.get('rating', 3);
      let prevSum = resource.data.get('ratingSum', prevRating * prevCount);
      return affected.hasOnly(['rating', 'ratingCount', 'ratingSum', 'updatedAt'])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.ratingCount is number
        && request.resource.data.ratingCount == prevCount + 1
        && request.resource.data.ratingSum is number
        && request.resource.data.ratingSum >= prevSum + 1
        && request.resource.data.ratingSum <= prevSum + 5;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /loos/{looId} {
      allow read: if true;

      allow create: if pinCreateAuthed() || pinCreateAnonymous();

      allow update: if request.auth != null && isAdmin();

      allow update: if request.auth != null
        && ownerUpdateKeysOk()
        && claimOwnerOk();

      allow update: if request.auth != null
        && noOwnerPin()
        && openPinFieldUpdateOk()
        && claimOwnerOk();

      allow update: if publicRatingVoteOk();

      allow delete: if request.auth != null && isAdmin();
    }

    match /restaurants_cafes/{pinId} {
      allow read: if true;

      allow create: if pinCreateAuthed() || pinCreateAnonymous();

      allow update: if request.auth != null && isAdmin();

      allow update: if request.auth != null
        && ownerUpdateKeysOk()
        && claimOwnerOk();

      allow update: if request.auth != null
        && noOwnerPin()
        && openPinFieldUpdateOk()
        && claimOwnerOk();

      allow update: if publicRatingVoteOk();

      allow delete: if request.auth != null && isAdmin();
    }

    match /tambayan_24h/{pinId} {
      allow read: if true;

      allow create: if pinCreateAuthed() || pinCreateAnonymous();

      allow update: if request.auth != null && isAdmin();

      allow update: if request.auth != null
        && ownerUpdateKeysOk()
        && claimOwnerOk();

      allow update: if request.auth != null
        && noOwnerPin()
        && openPinFieldUpdateOk()
        && claimOwnerOk();

      allow update: if publicRatingVoteOk();

      allow delete: if request.auth != null && isAdmin();
    }
  }
}
