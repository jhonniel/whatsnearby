VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: comma-separated Firebase Auth UIDs treated as admins in the UI (Firestore rules still require admins/{uid}).
# VITE_ADMIN_UIDS=abc123,def456

# For `npm run seed:admin` (service account JSON path — never commit the key file):
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# ADMIN_EMAIL=admin@example.com
